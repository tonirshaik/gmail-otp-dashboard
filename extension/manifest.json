{
  "manifest_version": 3,
  "name": "OTP Dashboard helper",
  "version": "1.0.0",
  "description": "Copy or auto-fill the latest code from your OTP Dashboard.",
  "icons": { "16": "icons/icon-192.png", "32": "icons/icon-192.png", "48": "icons/icon-192.png", "128": "icons/icon-512.png" },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["@@ORIGIN@@/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "OTP Dashboard", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-192.png", "32": "icons/icon-192.png", "48": "icons/icon-192.png", "128": "icons/icon-512.png" } },
  "content_scripts": [
    { "matches": ["https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
